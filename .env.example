# Public production URL (no trailing slash). Local preview does not need a domain.
SITE_URL=http://localhost:3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames, without scheme or ports
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
REDIS_URL=redis://localhost:6379
# Enable only behind a trusted proxy that replaces incoming X-Forwarded-For
TRUST_PROXY=false
# Remains false until real operator details, jurisdiction, policy and consent are ready
PRIVACY_READY=false
